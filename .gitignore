# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example no lleva secretos y es la referencia que citan el README, los
# documentos de docs/ y el error de src/lib/db.ts. Tiene que viajar en el repo.
!.env.example

# vercel
.vercel

# cloudflare / opennext (PoC Fase 0)
/.open-next/
/.wrangler/
.dev.vars
cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated

# Base de datos local de SQLite. Son datos del cliente, no código.
*.db
*.db-journal
*.db-wal
*.db-shm

# Imágenes subidas desde el panel. También son datos del cliente.
/public/uploads/*
!/public/uploads/.gitkeep

# Restos de montajes FUSE (aparecen al editar sobre un recurso compartido)
.fuse_hidden*
