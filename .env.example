# =====================================================================
# Configuración de la Tienda
# Copiá este archivo como `.env` y llenalo. El `.env` NO se sube a git.
# =====================================================================

# ---------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------
# En desarrollo es un archivo SQLite: no hay que instalar ni pagar nada.
# Para producción se cambia por Turso o Neon (ambos con plan gratis).
# Ver docs/despliegue.md
# La ruta es relativa a la raíz del proyecto.
DATABASE_URL="file:./prisma/tienda.db"

# ---------------------------------------------------------------------
# SESIÓN
# ---------------------------------------------------------------------
# Clave con la que se firman las cookies de sesión del panel.
# Generá una propia con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si esta clave cambia, todas las sesiones abiertas se cierran.
#
# OJO: este valor de ejemplo es público. La aplicación avisa en desarrollo y
# SE NIEGA A ARRANCAR en producción mientras siga puesto.
SESSION_SECRET="cambiame-por-una-clave-larga-y-aleatoria"

# ---------------------------------------------------------------------
# PRIMER USUARIO ADMINISTRADOR
# ---------------------------------------------------------------------
# Lo crea el seed la primera vez. Después se administra desde /admin/usuarios.
#
# Igual que el secreto: estas credenciales están publicadas en el README, así
# que el seed se niega a usarlas en producción.
ADMIN_EMAIL="admin@tienda.local"
ADMIN_PASSWORD="tienda2026"
ADMIN_NOMBRE="Administrador"

# ---------------------------------------------------------------------
# ORIGEN DE LAS EXISTENCIAS
# ---------------------------------------------------------------------
# "prisma" -> el stock vive en esta misma base de datos (lo normal hoy).
# "api"    -> el stock lo manda un sistema externo (facturación / punto de
#             venta). Todavía no está implementado: ver docs/integraciones.md
INVENTARIO_PROVIDER="prisma"

# Solo se usan cuando INVENTARIO_PROVIDER="api"
INVENTARIO_API_URL=""
INVENTARIO_API_TOKEN=""

# ---------------------------------------------------------------------
# ALMACENAMIENTO DE IMÁGENES
# ---------------------------------------------------------------------
# "local" -> se guardan en public/uploads (bien para desarrollo y VPS).
# "r2"    -> Cloudflare R2 (producción en Workers). El bucket NO va acá: llega
#            por el binding FOTOS de wrangler.jsonc. Las fotos se sirven por la
#            ruta /uploads/<clave> (misma URL que en local). Ver
#            docs/plan-migracion-cloudflare.md (Fase 1).
# Cualquier hosting con disco efímero (Vercel) necesita "r2". Ver docs/integraciones.md
STORAGE_PROVIDER="local"

# ---------------------------------------------------------------------
# ORÍGENES PERMITIDOS PARA SERVER ACTIONS
# ---------------------------------------------------------------------
# Solo hace falta detrás de un proxy inverso o un túnel. Next rechaza las
# server actions cuando el Origin del navegador no coincide con el Host que ve
# el servidor: el navegador dice "algo.trycloudflare.com" y el servidor se cree
# "localhost:3000". Como todo el panel -incluido el login- son server actions,
# el síntoma es que no se puede ni entrar.
#
# Vacío en desarrollo y en un despliegue normal: sin proxy no hay que aflojar
# nada. Acepta varios separados por coma y comodines ("*.trycloudflare.com").
# Ver docs/demo-tunnel.md
ORIGENES_PERMITIDOS=""
