{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "blueprint-catalogo",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DB_PROVIDER": "d1",
    "STORAGE_PROVIDER": "r2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blueprint-catalogo",
      // Placeholder para desarrollo local (Miniflare indexa por database_name).
      // En un clon real se reemplaza por el id de `wrangler d1 create`.
      "database_id": "local-dev-placeholder"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOTOS",
      "bucket_name": "blueprint-catalogo-fotos"
    }
  ]
}
